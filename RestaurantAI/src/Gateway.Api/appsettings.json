{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Authentication": {
    "Jwt": {
      "Issuer": "restaurant-ai",
      "Audience": "restaurant-ai-api"
    }
  },
  "RateLimiting": {
    "TenantPermitsPerMinute": 600,
    "AnonymousPermitsPerMinute": 60,
    "QueueLimit": 0
  },
  "ReverseProxy": {
    "Routes": {
      "identity": {
        "ClusterId": "identity",
        "AuthorizationPolicy": "anonymous",
        "RateLimiterPolicy": "per-tenant",
        "Match": {
          "Path": "/api/auth/{**catch-all}"
        }
      },
      "consumer": {
        "ClusterId": "consumer",
        "AuthorizationPolicy": "authenticated",
        "RateLimiterPolicy": "per-tenant",
        "Match": {
          "Path": "/api/consumer/{**catch-all}"
        }
      },
      "restaurant": {
        "ClusterId": "restaurant",
        "AuthorizationPolicy": "authenticated",
        "RateLimiterPolicy": "per-tenant",
        "Match": {
          "Path": "/api/restaurants/{**catch-all}"
        }
      },
      "menu": {
        "ClusterId": "menu",
        "AuthorizationPolicy": "authenticated",
        "RateLimiterPolicy": "per-tenant",
        "Match": {
          "Path": "/api/menu/{**catch-all}"
        }
      },
      "order": {
        "ClusterId": "order",
        "AuthorizationPolicy": "authenticated",
        "RateLimiterPolicy": "per-tenant",
        "Match": {
          "Path": "/api/orders/{**catch-all}"
        }
      },
      "reservation": {
        "ClusterId": "reservation",
        "AuthorizationPolicy": "authenticated",
        "RateLimiterPolicy": "per-tenant",
        "Match": {
          "Path": "/api/reservations/{**catch-all}"
        }
      },
      "loyalty": {
        "ClusterId": "loyalty",
        "AuthorizationPolicy": "authenticated",
        "RateLimiterPolicy": "per-tenant",
        "Match": {
          "Path": "/api/loyalty/{**catch-all}"
        }
      },
      "admin": {
        "ClusterId": "admin",
        "AuthorizationPolicy": "platform-admin",
        "RateLimiterPolicy": "per-tenant",
        "Match": {
          "Path": "/api/admin/{**catch-all}"
        }
      },
      "discovery-restaurants": {
        "ClusterId": "restaurant",
        "AuthorizationPolicy": "anonymous",
        "RateLimiterPolicy": "per-tenant",
        "Match": {
          "Path": "/api/discovery/restaurants/{**catch-all}"
        }
      },
      "discovery-menu-items": {
        "ClusterId": "menu",
        "AuthorizationPolicy": "anonymous",
        "RateLimiterPolicy": "per-tenant",
        "Match": {
          "Path": "/api/discovery/menu-items/{**catch-all}"
        }
      },
      "ai": {
        "ClusterId": "ai",
        "AuthorizationPolicy": "authenticated",
        "RateLimiterPolicy": "per-tenant",
        "Match": {
          "Path": "/api/ai/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "identity": {
        "Destinations": {
          "primary": {
            "Address": "http://localhost:5201/"
          }
        }
      },
      "consumer": {
        "Destinations": {
          "primary": {
            "Address": "http://localhost:5202/"
          }
        }
      },
      "restaurant": {
        "Destinations": {
          "primary": {
            "Address": "http://localhost:5203/"
          }
        }
      },
      "menu": {
        "Destinations": {
          "primary": {
            "Address": "http://localhost:5204/"
          }
        }
      },
      "order": {
        "Destinations": {
          "primary": {
            "Address": "http://localhost:5205/"
          }
        }
      },
      "reservation": {
        "Destinations": {
          "primary": {
            "Address": "http://localhost:5206/"
          }
        }
      },
      "loyalty": {
        "Destinations": {
          "primary": {
            "Address": "http://localhost:5207/"
          }
        }
      },
      "admin": {
        "Destinations": {
          "primary": {
            "Address": "http://localhost:5208/"
          }
        }
      },
      "ai": {
        "HttpRequest": {
          "ActivityTimeout": "00:03:00"
        },
        "Destinations": {
          "primary": {
            "Address": "http://localhost:5300/"
          }
        }
      }
    }
  }
}
