{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Redis": "localhost:6379"
  },
  "Authentication": {
    "Jwt": {
      "Issuer": "restaurant-ai",
      "Audience": "restaurant-ai-api"
    }
  },
  "Services": {
    "Gateway": "http://localhost:5080"
  },
  "RabbitMQ": {
    "ConnectionString": "amqp://guest:guest@localhost:5672",
    "Exchange": "restaurant.events",
    "ClientName": "mcp-gateway"
  }
}
