{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Platform": "Host=localhost;Port=5432;Database=restaurant_ai;Username=restaurant_app;Password=restaurant_app",
    "Redis": "localhost:6379"
  },
  "Authentication": {
    "Jwt": {
      "Issuer": "restaurant-ai",
      "Audience": "restaurant-ai-api"
    }
  },
  "RabbitMQ": {
    "ConnectionString": "amqp://guest:guest@localhost:5672",
    "Exchange": "restaurant.events",
    "ClientName": "reservation-api"
  },
  "Outbox": {
    "Enabled": true,
    "PollingInterval": "00:00:02",
    "BatchSize": 50,
    "MaxAttempts": 10
  }
}
